# Barclays Campaign Studio — AI service configuration
#
# Copy to `.env` locally. `.env` is gitignored and must never be committed.
# Every value below is read SERVER-SIDE ONLY. None of these names may appear
# in client code, and none of these values are ever sent to the browser.
# The browser only ever learns booleans via GET /api/ai/health.

# mock  = deterministic V19 demo behaviour, no provider call at all
# gemini = route through the internal gateway
AI_MODE=mock

# Only the internal gateway is supported. Never call a provider directly.
AI_BACKEND=internal_gateway

# Base URL of the internal gateway, without a trailing slash.
# The transport appends /chat/completions.
# Example: https://gateway.internal.example/v1
AI_GATEWAY_BASE_URL=

# Service credential for the internal gateway. Secret.
# Example: replace-with-gateway-key
AI_GATEWAY_API_KEY=

# Wire protocol spoken by the gateway. Currently only "openai"
# (OpenAI-compatible chat completions with json_schema response_format).
AI_GATEWAY_PROTOCOL=openai

# Gemini model identifier as exposed by the gateway.
# Example: gemini-2.5-pro
GEMINI_MODEL=

# Optional. Request timeout in milliseconds. Defaults to 30000.
AI_GATEWAY_TIMEOUT_MS=


# ------------------------------------------------------------------
# Image generation (Adobe Firefly Services)
# ------------------------------------------------------------------
# Also SERVER-SIDE ONLY. The browser only learns booleans via
# GET /api/images/health, and only ever receives an app-relative asset URL.

# mock    = no Adobe call at all; Stage 7 keeps the existing V19 creative
# firefly = reference-guided generation through Adobe Firefly Services
IMAGE_GENERATION_PROVIDER=mock

# OAuth Server-to-Server credentials from the Adobe Developer Console project.
# The client id is also sent as the Firefly `x-api-key` header. Both are secret.
# Example: replace-with-adobe-client-id
ADOBE_FIREFLY_CLIENT_ID=
# Example: replace-with-adobe-client-secret
ADOBE_FIREFLY_CLIENT_SECRET=

# Optional, non-secret. Defaults to https://firefly-api.adobe.io
ADOBE_FIREFLY_API_BASE_URL=

# Optional, non-secret. Defaults to https://ims-na1.adobelogin.com
ADOBE_IMS_BASE_URL=

# Optional, non-secret. Defaults to the documented Firefly Services scope:
# openid,AdobeID,session,additional_info,read_organizations,firefly_api,ff_apis
ADOBE_FIREFLY_SCOPE=

# Optional. Request timeout in milliseconds. Defaults to 60000.
IMAGE_GENERATION_TIMEOUT_MS=
