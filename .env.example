# Barclays V19 — AI service configuration (SERVER-SIDE ONLY)
#
# Copy to `.env` locally. Never commit `.env`.
# None of these names may be `VITE_`-prefixed (that would inline secrets into the browser).
# Restart `npm run dev` after changing values.

# mock  = no Gemini provider call
# gemini = route through the internal gateway (also accept GEMINI_LIVE=1)
AI_MODE=mock

# Only the internal gateway is supported for application traffic.
AI_BACKEND=internal_gateway

# Base URL of the internal gateway INCLUDING the API base path, no trailing slash.
# Transport appends /chat/completions.
# Example shape: https://<internal-host>/v1
AI_GATEWAY_BASE_URL=

# Gateway credential. Secret.
AI_GATEWAY_API_KEY=

# Wire protocol. Currently only "openai".
AI_GATEWAY_PROTOCOL=openai

# Model alias exposed by the gateway (not necessarily a public Google id).
GEMINI_MODEL=

# Optional. Request timeout in milliseconds. Defaults to 30000.
AI_GATEWAY_TIMEOUT_MS=30000

# Optional structured-output mode: json_object (default) | json_schema | none
AI_GATEWAY_STRUCTURED_OUTPUT=json_object

# Optional path override. Defaults to /chat/completions.
# AI_GATEWAY_CHAT_PATH=/chat/completions

# Backward-compatible live switch (prefer AI_MODE=gemini).
# GEMINI_LIVE=1

# ------------------------------------------------------------------
# Gemini image generation / image editing (Modify asset only)
# ------------------------------------------------------------------
# Server-side only. Do not expose as VITE_GEMINI_IMAGE_API_KEY.
# Protocol: OpenAI-compatible POST /images/edits on the gateway (default),
# or Google generateContent when GEMINI_IMAGE_PROTOCOL=google.
GEMINI_IMAGE_API_KEY=your_gemini_image_api_key_here
# Image-capable model alias (required for live Modify image edits).
# Examples: gemini-2.5-flash-image | vertex_ai.gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=
# Optional. Defaults to AI_GATEWAY_BASE_URL when unset.
GEMINI_IMAGE_BASE_URL=
# Optional. openai_images_edits (default) | google_generate_content
# GEMINI_IMAGE_PROTOCOL=openai_images_edits
# Image edits take far longer than text completions, so this NEVER inherits
# AI_GATEWAY_TIMEOUT_MS. Defaults to 120000 when unset.
GEMINI_IMAGE_TIMEOUT_MS=120000
# Optional live switch for image edits (also accepts AI_MODE=gemini / GEMINI_LIVE=1).
# GEMINI_IMAGE_LIVE=1

# ------------------------------------------------------------------
# Image generation (Adobe Firefly Services) — unchanged
# ------------------------------------------------------------------
IMAGE_GENERATION_PROVIDER=mock
ADOBE_FIREFLY_CLIENT_ID=
ADOBE_FIREFLY_CLIENT_SECRET=
# FIREFLY_LIVE=1
